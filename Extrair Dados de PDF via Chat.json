    {
      "parameters": {
        "promptType": "define",
        "text": "=Extraia do texto abaixo os dados de TODAS as pessoas/credores mencionados e retorne um JSON com o campo \"pessoas\", que é uma lista de objetos com os campos nome, cpf, endereco e telefone — um objeto por pessoa encontrada.\n\nTexto extraído do PDF:\n{{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Você é um assistente especializado em extrair dados pessoais de documentos. Extraia TODOS os registros de pessoas/credores presentes no texto, sem omitir nenhum. Retorne sempre o JSON estruturado solicitado, com a lista \"pessoas\" contendo um objeto por pessoa. Se algum campo de uma pessoa não estiver presente no texto, retorne-o como string vazia."
        }
      },
      "id": "2eb8eb9a-e549-499b-b2ac-4c8c47efd95b",
