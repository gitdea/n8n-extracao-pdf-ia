      "parameters": {
        "promptType": "define",
        "text": "=Pergunta do usuário:\n{{ $('Chat Trigger').item.json.chatInput }}\n\nRegistros atualmente na base de dados de precatórios (JSON por linha):\n{{ $input.all().filter(i => Object.keys(i.json).length > 0).map(i => JSON.stringify(i.json)).join('\\n') || 'Nenhum registro cadastrado ainda.' }}\n\nResponda à pergunta usando APENAS os registros acima.",
