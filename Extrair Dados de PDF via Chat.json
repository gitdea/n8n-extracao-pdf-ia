    {
      "parameters": {
        "jsCode": "const out = $('AI Agent Extrator').item.json.output || {};\nconst pessoas = out.pessoas || [];\nreturn pessoas.map(p => ({ json: {\n  nome: p.nome || '',\n  cpf: p.cpf || '',\n  endereco: p.endereco || '',\n  telefone: p.telefone || ''\n} }));"
      },
