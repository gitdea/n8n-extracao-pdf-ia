    {
      "parameters": {
        "jsonSchemaExample": "{\"pessoas\":[{\"nome\":\"Maria da Silva\",\"cpf\":\"123.456.789-00\",\"endereco\":\"Rua das Flores, 123 - São Paulo/SP\",\"telefone\":\"(11) 98765-4321\"}]}"
      },
      "id": "205fb38a-fa25-4e95-b3bf-1d0447a656d9",
      "name": "Parser JSON",
